# ── Обязательно ──────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=

# ── Необязательно ────────────────────────────────────────────
# Твой Telegram ID (узнать: @userinfobot).
# Если оставить пустым — бот станет твоим, когда ты первым нажмёшь /start.
OWNER_ID=

# Часовой пояс для утренних и вечерних напоминаний.
# По умолчанию — как на компьютере. Примеры: Europe/Moscow, Europe/Kyiv, Asia/Almaty
TIMEZONE=

# Папка для базы и фото (по умолчанию — ./data рядом с ботом)
DATA_DIR=

# Прокси, если Telegram не открывается напрямую.
# Пример: socks5://user:pass@127.0.0.1:1080  (понадобится: pip install aiohttp-socks)
PROXY=
