# ── Обязательно ──────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=

# ── Необязательно ────────────────────────────────────────────
# Твой Telegram ID (узнать: @userinfobot).
# Если оставить пустым — бот станет твоим, когда ты первым нажмёшь /start.
OWNER_ID=

# Часовой пояс для утренних и вечерних напоминаний.
# По умолчанию — как на компьютере. Примеры: Europe/Moscow, Europe/Kyiv, Asia/Almaty
TIMEZONE=

# Папка для базы и фото (по умолчанию — ./data рядом с ботом)
DATA_DIR=

# ── Нейросеть для категорий (необязательно) ─────────────────
# Бесплатный ключ: Groq (gsk_…) — console.groq.com/keys, OpenRouter (sk-or-…) — openrouter.ai/keys.
# По ключу бот сам поймёт сервис. Для другого OpenAI-совместимого API задай AI_BASE_URL и AI_MODEL.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ── Если api.telegram.org недоступен (например, из России) ──
# Прокси: socks5://user:pass@host:1080 или http://host:3128 (понадобится: pip install aiohttp-socks)
PROXY=
# Или свой адрес-зеркало Bot API (например, собственный прокси-воркер): https://my-mirror.example.com
TELEGRAM_API_URL=

# ── Мини-приложение (кнопка «Приложение» в чате) ────────────
# Нужен публичный HTTPS-адрес. На сервере установщик настраивает его сам (Caddy + <ip>.sslip.io).
# Можно несколько адресов через запятую — бот возьмёт первый, который открывается.
WEBAPP_URL=
# Где бот слушает запросы приложения (за HTTPS-прокси). По умолчанию 127.0.0.1:8080.
WEBAPP_PORT=
WEBAPP_HOST=
