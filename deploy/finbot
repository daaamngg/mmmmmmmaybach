#!/usr/bin/env bash
# Управление ботом на сервере. Ставится установщиком в /usr/local/bin/finbot.
set -euo pipefail

APP_DIR="${APP_DIR:-/opt/finbot}"
ENV_FILE="/etc/finbot.env"
DATA_ROOT="/var/lib/finbot"
DATA_DIR="$DATA_ROOT/data"
SERVICE="finbot"
BOT_USER="finbot"

say()  { printf '\033[1;32m▶\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m✖ %s\033[0m\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
Управление ботом:
  finbot doctor            бот молчит? проверит всё и скажет, что исправить
  finbot status            работает ли бот
  finbot logs              лог в реальном времени (выход — Ctrl+C)
  finbot restart           перезапустить
  finbot stop | start      остановить / запустить
  finbot update            скачать новую версию бота и перезапустить
  finbot token             сменить токен (после перевыпуска в @BotFather)
  finbot owner ID          сделать владельцем бота этот Telegram ID
  finbot webapp            мини-приложение: открывается ли
  finbot webapp on [домен] включить мини-приложение (HTTPS настроится сам;
                           свой домен запоминается, «auto» — снова бесплатный адрес)
  finbot webapp off        выключить мини-приложение
  finbot ai                подключить или отключить нейросеть для категорий
  finbot ai-status         работает ли нейросеть
  finbot backup            сохранить копию базы и фото в /root
  finbot import ПУТЬ       перенести данные с ноутбука (папка data или файл finbot.db)
EOF
}

set_env() {
    local tmp
    tmp="$(mktemp)"
    K="$1" V="$2" awk 'BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"]; done = 0 }
        index($0, k "=") == 1 { print k "=" v; done = 1; next }
        { print }
        END { if (!done) print k "=" v }' "$ENV_FILE" >"$tmp"
    cat "$tmp" >"$ENV_FILE"
    rm -f "$tmp"
    chmod 600 "$ENV_FILE"
}

get_env() { grep -E "^$1=" "$ENV_FILE" 2>/dev/null | tail -n 1 | cut -d= -f2- || true; }

restart_and_check() {  # restart_and_check [start|restart]
    local since
    since="$(date '+%Y-%m-%d %H:%M:%S')"
    systemctl "${1:-restart}" "$SERVICE"
    for _ in $(seq 1 20); do
        sleep 1
        if journalctl -u "$SERVICE" --since "$since" -q --no-pager 2>/dev/null | grep -q "запущен"; then
            say "Бот работает."
            return 0
        fi
        [ "$(systemctl is-active "$SERVICE")" != failed ] || break
    done
    warn "Бот не подтвердил запуск. Последние строки лога:"
    journalctl -u "$SERVICE" --since "$since" -n 15 --no-pager || true
    return 1
}

ai_check() {  # ждём результат пробного запроса к нейросети (его делает бот при запуске)
    local line=""
    for _ in $(seq 1 20); do
        line="$(journalctl -u "$SERVICE" -n 40 -q --no-pager -o cat 2>/dev/null | grep -E "Нейросеть (отвечает|не работает)" | tail -n 1 || true)"
        [ -n "$line" ] && break
        sleep 1
    done
    if [ -z "$line" ]; then
        warn "Нейросеть пока не ответила — проверь позже в боте: ⚙️ Настройки."
    elif [[ "$line" == *"отвечает"* ]]; then
        say "${line#*: }"
    else
        warn "${line#*: }"
    fi
}

webapp_ok() {  # webapp_ok URL — открывается ли по адресу именно наш бот (снаружи или через этот же сервер)
    local url="$1" host
    host="${url#https://}"
    host="${host%%/*}"
    curl -fsS --max-time 10 "$url/healthz" 2>/dev/null | grep -q '"ok"' && return 0
    curl -fsS --max-time 10 --resolve "$host:443:127.0.0.1" "$url/healthz" 2>/dev/null | grep -q '"ok"'
}

webapp_wait() {  # ждём, пока бот убедится, что мини-приложение открывается (сертификат — до пары минут)
    local since line=""
    [ -n "$(get_env WEBAPP_URL)" ] || return 0
    since="$(systemctl show -p ActiveEnterTimestamp --value "$SERVICE" 2>/dev/null || true)"
    printf '   Жду HTTPS-сертификат для мини-приложения'
    for _ in $(seq 1 50); do
        line="$(journalctl -u "$SERVICE" ${since:+--since "$since"} -q --no-pager -o cat 2>/dev/null |
            grep -E "Мини-приложение (доступно|не запустилось)" | tail -n 1 || true)"
        [ -n "$line" ] && break
        printf '.'
        sleep 3
    done
    echo
    if [[ "$line" == *"доступно:"* ]]; then
        say "📱 ${line#*: }"
        echo "   В чате с ботом появилась кнопка «Приложение» (слева от поля ввода) и команда /app."
    elif [ -n "$line" ]; then
        warn "${line#*: }"
        return 1
    else
        warn "Мини-приложение пока не открывается — Caddy ещё получает сертификат."
        warn "Проверь через пару минут: finbot doctor. Кнопка в чате появится сама."
        return 1
    fi
}

tg_call() {  # tg_call МЕТОД — запрос к Telegram тем же путём, что у бота; токен не виден в списке процессов
    local base proxy
    base="$(get_env TELEGRAM_API_URL)"
    base="${base:-https://api.telegram.org}"
    proxy="$(get_env PROXY)"
    printf 'url = "%s/bot%s/%s"\n' "${base%/}" "$(get_env BOT_TOKEN)" "$1" |
        curl -sS --max-time 15 ${proxy:+--proxy "$proxy"} -K - 2>&1 || true
}

json_field() {  # json_field ВЫРАЖЕНИЕ — поле из JSON на входе (d — разобранный ответ)
    "$APP_DIR/.venv/bin/python" -c '
import json, sys
try:
    d = json.load(sys.stdin)
    print(eval(sys.argv[1]) or "")
except Exception:
    print("")' "$1" 2>/dev/null || true
}

doctor() {
    local problems=0 token owner resp username code url urls ok_url line strangers errors
    echo "🩺 Проверяю бота…"
    echo

    if systemctl is-active -q "$SERVICE"; then
        say "Бот запущен (с $(systemctl show -p ActiveEnterTimestamp --value "$SERVICE"))."
    else
        warn "Бот НЕ запущен ($(systemctl is-active "$SERVICE" 2>/dev/null || true)). Последние строки лога:"
        journalctl -u "$SERVICE" -n 12 --no-pager -o cat 2>/dev/null | sed 's/^/     /' || true
        problems=$((problems + 1))
    fi

    token="$(get_env BOT_TOKEN)"
    if [[ ! "$token" =~ ^[0-9]{5,}:[A-Za-z0-9_-]{30,}$ ]]; then
        warn "Токен в $ENV_FILE не похож на настоящий. Исправить: finbot token"
        problems=$((problems + 1))
    else
        resp="$(tg_call getMe)"
        if [[ "$resp" == "{"* ]]; then
            username="$(json_field "d['result']['username'] if d.get('ok') else ''" <<<"$resp")"
            code="$(json_field "d.get('error_code')" <<<"$resp")"
            if [ -n "$username" ]; then
                say "Telegram на связи, токен рабочий: @$username"
            elif [ "$code" = 401 ] || [ "$code" = 404 ]; then
                warn "Telegram НЕ принимает токен — его перевыпустили в @BotFather? Вставь новый: finbot token"
                problems=$((problems + 1))
            else
                warn "Telegram ответил ошибкой: $(json_field "d.get('description')" <<<"$resp")"
                problems=$((problems + 1))
            fi
            url="$(json_field "d['result'].get('url')" <<<"$(tg_call getWebhookInfo)")"
            if [ -n "$url" ]; then
                warn "На токене висит вебхук другого сервиса ($url) — из-за него сообщения не доходят."
                warn "Бот снимает его при запуске: finbot restart"
                problems=$((problems + 1))
            fi
        else
            warn "Нет связи с Telegram: ${resp:-нет ответа}"
            warn "Сервер в России? Оттуда Telegram заблокирован — нужен сервер за границей (или PROXY в $ENV_FILE)."
            problems=$((problems + 1))
        fi
    fi

    owner="$(get_env OWNER_ID)"
    if [ -n "$owner" ]; then
        say "Владелец: Telegram ID $owner — бот отвечает только этому аккаунту."
    else
        warn "OWNER_ID не задан — бот принадлежит тому, кто первым отправил ему /start."
    fi
    strangers="$(journalctl -u "$SERVICE" --since "7 days ago" -q --no-pager -o cat 2>/dev/null |
        grep -oE 'Чужой пользователь .+ \(id=[0-9]+\)' | sed -E 's/^Чужой пользователь //' | sort -u | tail -n 5 || true)"
    if [ -n "$strangers" ]; then
        warn "Боту писали с других аккаунтов (им он не отвечает):"
        printf '%s\n' "$strangers" | sed 's/^/     /'
        warn "Если среди них ты — выполни: finbot owner ТВОЙ_ID"
    fi

    if journalctl -u "$SERVICE" --since "30 min ago" -q --no-pager -o cat 2>/dev/null | grep -q "Conflict"; then
        warn "Этот же бот запущен где-то ещё (например, на ноутбуке) — сообщения уходят то туда, то сюда."
        warn "Останови второй экземпляр: бот должен работать только здесь, на сервере."
        problems=$((problems + 1))
    fi

    urls="$(get_env WEBAPP_URL)"
    if [ -z "$urls" ]; then
        warn "Мини-приложение выключено. Включить: finbot webapp on"
    else
        if systemctl is-active -q caddy 2>/dev/null; then
            say "Caddy (HTTPS для мини-приложения) работает."
        else
            warn "Caddy не работает: systemctl status caddy"
            problems=$((problems + 1))
        fi
        ok_url=""
        for url in ${urls//,/ }; do
            if webapp_ok "$url"; then
                ok_url="$url"
                break
            fi
        done
        if [ -n "$ok_url" ]; then
            say "Мини-приложение открывается: $ok_url"
        else
            warn "Мини-приложение пока не открывается (${urls//,/, })."
            journalctl -u caddy --since "3 hours ago" -q --no-pager -o cat 2>/dev/null |
                grep -iE 'error|rate.?limit' | tail -n 2 | cut -c1-240 | sed 's/^/     /' || true
            warn "Если так дольше 10 минут — проверь в панели хостинга, что открыты входящие порты 80 и 443."
            problems=$((problems + 1))
        fi
    fi

    if grep -qE '^AI_API_KEY=.+' "$ENV_FILE"; then
        line="$(journalctl -u "$SERVICE" -n 500 -q --no-pager -o cat 2>/dev/null |
            grep -E "Нейросеть (отвечает|не работает)" | tail -n 1 || true)"
        if [[ "$line" == *"отвечает"* ]]; then
            say "${line#*: }"
        elif [ -n "$line" ]; then
            warn "${line#*: }"
        fi
    fi

    errors="$(journalctl -u "$SERVICE" --since "1 day ago" -q --no-pager -o cat 2>/dev/null |
        grep -E '\| (ERROR|CRITICAL) ' | tail -n 3 || true)"
    if [ -n "$errors" ]; then
        warn "Ошибки за сутки (последние):"
        printf '%s\n' "$errors" | cut -c1-240 | sed 's/^/     /'
    fi

    echo
    if [ "$problems" -eq 0 ]; then
        say "Всё в порядке. Открой бота${username:+ https://t.me/$username} и отправь /start${owner:+ с аккаунта, у которого ID $owner}."
    else
        warn "Проблем: $problems. Исправь по подсказкам выше и запусти finbot doctor ещё раз."
        return 1
    fi
}

snapshot_db() {  # snapshot_db КУДА — целостная копия базы, даже если бот работает
    "$APP_DIR/.venv/bin/python" - "$DATA_DIR/finbot.db" "$1" <<'PY'
import sqlite3, sys
src = sqlite3.connect(sys.argv[1])
dst = sqlite3.connect(sys.argv[2])
src.backup(dst)
dst.close()
src.close()
PY
}

cmd="${1:-help}"
[ "$cmd" = help ] || [ "$cmd" = -h ] || [ "$cmd" = --help ] || [ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"

case "$cmd" in
    status)
        systemctl status "$SERVICE" --no-pager -l | head -n 15
        ;;
    logs)
        journalctl -u "$SERVICE" -n 50 -f --no-pager
        ;;
    stop)
        systemctl stop "$SERVICE"
        say "Бот остановлен."
        ;;
    restart | start)
        restart_and_check "$cmd"
        ;;
    update)
        branch="$(git -C "$APP_DIR" rev-parse --abbrev-ref HEAD)"
        say "Скачиваю обновление ($branch)…"
        git -C "$APP_DIR" fetch -q --depth 1 origin "$branch"
        git -C "$APP_DIR" reset -q --hard FETCH_HEAD
        # Установщик запускаем из копии: git может заменить файл прямо во время работы.
        tmp="$(mktemp)"
        cp "$APP_DIR/deploy/install.sh" "$tmp"
        SKIP_FETCH=1 bash "$tmp"
        rm -f "$tmp"
        ;;
    token)
        read -r -s -p "Новый токен от @BotFather (ввод скрыт): " token
        echo
        [[ "$token" =~ ^[0-9]{5,}:[A-Za-z0-9_-]{30,}$ ]] || die "Это не похоже на токен."
        set_env BOT_TOKEN "$token"
        say "Токен сохранён (бот id ${token%%:*}). Перезапускаю…"
        restart_and_check
        ;;
    doctor)
        doctor
        ;;
    owner)
        id="${2:-}"
        [[ "$id" =~ ^[0-9]{3,}$ ]] || die "Укажи свой Telegram ID цифрами: finbot owner 123456789 (узнать ID: @userinfobot)"
        set_env OWNER_ID "$id"
        say "Владелец теперь $id. Перезапускаю…"
        restart_and_check && echo "   Открой бота в Telegram (с этого аккаунта) и отправь /start."
        ;;
    webapp)
        case "${2:-}" in
            on)
                set_env WEBAPP on
                domain="${3:-}"
                if [ "$domain" = auto ]; then
                    set_env WEBAPP_DOMAIN ""
                    domain=""
                fi
                WEBAPP_DOMAIN="$domain" ENV_FILE="$ENV_FILE" bash "$APP_DIR/deploy/webapp.sh" ||
                    die "Мини-приложение не настроено — причина выше."
                restart_and_check && webapp_wait
                ;;
            off)
                set_env WEBAPP off
                set_env WEBAPP_URL ""
                if head -n 1 /etc/caddy/Caddyfile 2>/dev/null | grep -q "^# finbot"; then
                    systemctl disable -q --now caddy 2>/dev/null || true
                fi
                restart_and_check && say "Мини-приложение выключено, кнопка «Приложение» убрана."
                ;;
            wait)
                webapp_wait
                ;;
            "" | status)
                urls="$(get_env WEBAPP_URL)"
                if [ -z "$urls" ]; then
                    warn "Мини-приложение выключено. Включить: finbot webapp on"
                    exit 0
                fi
                for url in ${urls//,/ }; do
                    if webapp_ok "$url"; then say "Открывается: $url"; else warn "Не открывается: $url"; fi
                done
                line="$(journalctl -u "$SERVICE" -n 500 -q --no-pager -o cat 2>/dev/null |
                    grep -E "Мини-приложение (доступно|пока недоступно|не запустилось)" | tail -n 1 || true)"
                [ -z "$line" ] || echo "   Бот: ${line#*: }"
                ;;
            *)
                die "Использование: finbot webapp [on [домен] | off]"
                ;;
        esac
        ;;
    ai)
        cat <<'EOF'
Нейросеть подбирает категорию, когда бот не знает слово (работает в фоне, без задержек).
Бесплатные ключи (без банковской карты):
  • Groq       — https://console.groq.com/keys   (ключ начинается с gsk_)
  • OpenRouter — https://openrouter.ai/keys      (ключ начинается с sk-or-)
EOF
        read -r -p "Вставь ключ (пусто — отключить нейросеть): " key
        set_env AI_API_KEY "$key"
        if [ -n "$key" ]; then say "Ключ сохранён. Перезапускаю…"; else say "Нейросеть отключена. Перезапускаю…"; fi
        if restart_and_check && [ -n "$key" ]; then
            ai_check
        fi
        ;;
    ai-status)
        if grep -qE '^AI_API_KEY=.+' "$ENV_FILE"; then ai_check; else warn "Нейросеть не подключена: finbot ai"; fi
        ;;
    backup)
        stamp="$(date +%Y-%m-%d_%H%M)"
        tmp="$(mktemp -d)"
        snapshot_db "$tmp/finbot.db"
        [ -d "$DATA_DIR/photos" ] && cp -r "$DATA_DIR/photos" "$tmp/"
        out="/root/finbot-backup-$stamp.tar.gz"
        tar -czf "$out" -C "$tmp" .
        rm -rf "$tmp"
        say "Готово: $out"
        echo "   Скачать на компьютер: scp root@IP_СЕРВЕРА:$out ."
        ;;
    import)
        src="${2:-}"
        [ -n "$src" ] || die "Укажи, откуда брать: finbot import /root/data  (или путь к finbot.db)"
        if [ -d "$src" ]; then
            db="$src/finbot.db"
            photos="$src/photos"
        else
            db="$src"
            photos="$(dirname "$src")/photos"
        fi
        [ -f "$db" ] || die "Не нашёл базу: $db"
        say "Останавливаю бота и сохраняю текущие данные…"
        systemctl stop "$SERVICE" || true
        if [ -f "$DATA_DIR/finbot.db" ]; then
            keep="$DATA_ROOT/before-import-$(date +%Y-%m-%d_%H%M%S)"
            mv "$DATA_DIR" "$keep"
            echo "   Прежние данные: $keep"
        fi
        mkdir -p "$DATA_DIR"
        cp "$db" "$DATA_DIR/finbot.db"
        for ext in -wal -shm; do [ -f "$db$ext" ] && cp "$db$ext" "$DATA_DIR/finbot.db$ext"; done
        [ -d "$photos" ] && cp -r "$photos" "$DATA_DIR/"
        chown -R "$BOT_USER:$BOT_USER" "$DATA_ROOT"
        say "Данные перенесены. Запускаю…"
        restart_and_check start
        ;;
    help | -h | --help)
        usage
        ;;
    *)
        usage
        exit 1
        ;;
esac
